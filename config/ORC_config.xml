            <argument>* /shadows=oldest,mid,newest /config=res:#GetBrowsers_Artefacts.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="GetBrowsers_Artefacts.7z" source="File" argument="/out={FileName}" />
            <output name="GetBrowsers_Artefacts.log" source="StdOutErr" />
            <output name="GetBrowsers_Artefacts.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="GetResidents">
            <execute name="Orc.exe" run="self:#GetThis" />
            <argument>%systemdrive% /shadows={00000000-0000-0000-0000-000000000000} /config=res:#GetResidents.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="Residents.7z" source="File" argument="/out={FileName}" />
            <!-- GetResidents stdout is often larger than the actual archive => log only stderr -->
            <output name="Residents.log" source="StdErr" />
            <output name="Residents.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="GetExtAttrs" optional="yes">
            <execute name="Orc.exe" run="self:#GetThis" />
            <argument>* /config=res:#GetExtAttrs.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="ExtAttrs.7z" source="File" argument="/out={FileName}" />
            <output name="ExtAttrs.log" source="StdOutErr" />
            <output name="ExtAttrs.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="SystemInfo">
            <execute name="systeminfo.exe" run="%windir%\System32\systeminfo.exe" />
            <argument>/FO csv</argument>
            <output name="Systeminfo.csv" source="StdOutErr" />
        </command>

        <command keyword="Autoruns">
            <execute name="autorunsc.exe" run="7z:#Tools|autorunsc.exe"/>
            <argument>-accepteula -nobanner -c -h -s -t -a * *</argument>
            <output name="autoruns.csv" source="StdOut"/>
            <output name="autoruns.log" source="StdErr"/>
        </command>

        <command keyword="GetBootCode">
            <execute name="Orc.exe" run="self:#GetSectors" />
            <argument>/LegacyBootCode /UefiFull /SlackSpace /log:console,level=critical,backtrace=critical</argument>
            <output name="BootCode.7z" source="File" argument="/Out={FileName}" />
            <output name="BootCode.log" source="StdOutErr" />
            <output name="BootCode.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="Handle">
