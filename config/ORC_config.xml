        <!--
        #####################################################################
        ########
        ######## Powershell data collection
        ########
        #####################################################################
        -->

        <command keyword="PersistenceSniper" winver="6.0+" timeout="10">
            <execute name="powershell" run="%SystemRoot%\System32\WindowsPowerShell\V1.0\powershell.exe"/>
            <argument>-NonInteractive -WindowStyle Hidden -NoProfile</argument>
            <argument>Import-Module</argument>
            <input name="PersistenceSniper.psm1" source="7z:#Tools|PersistenceSniper.psm1" argument="{FileName}" />
            <argument>; Find-AllPersistence -Verbose | Export-Csv -NoTypeInformation -Encoding UTF8</argument>
            <output name="PersistenceSniper.csv" source="File" argument="-Path {FileName}" />
            <output name="PersistenceSniper.log" source="StdOutErr" />
        </command>

        <command keyword="DNS_records" systemtype="DomainController|Server" winver="6.0+" timeout="10">
            <execute name="powershell" run="%SystemRoot%\System32\WindowsPowerShell\V1.0\powershell.exe"/>
            <argument>-NonInteractive -WindowStyle Hidden -NoProfile</argument>
