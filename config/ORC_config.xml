<?xml version="1.0" encoding="utf-8"?>

<wolf childdebug="no" command_timeout="2880" archive_timeout="240">
    <log>
        <console level="critical" backtrace="critical"></console>
        <file level="info" backtrace="error">
            <output disposition="truncate">ORC_{SystemType}_{FullComputerName}_{TimeStamp}.log</output>
        </file>
    </log>

    <outline disposition="truncate">ORC_{SystemType}_{FullComputerName}_{TimeStamp}_Outline.json</outline>
    <outcome disposition="truncate">ORC_{SystemType}_{FullComputerName}_{TimeStamp}_Outcome.json</outcome>

    <archive name="ORC_{SystemType}_{FullComputerName}_Memory.7z" keyword="ORC_Memory" concurrency="1" repeat="Once" compression="fast" archive_timeout="240" optional="yes">
        <restrictions ElapsedTimeLimit="360" />

        <command keyword="capsule">
            <execute name="type" run="%windir%\System32\cmd.exe" />
            <argument>/c "rem"</argument>
            <output name="Capsule#{SystemType}#{FullComputerName}#{TimeStamp}#{RunId}.txt" source="StdOutErr" />
        </command>

        <!-- Assume most systems will have more than 2GB of RAM, thus preventing the memory dump when less than 4GB of disk space remains -->
        <command keyword="GetRam_dmp" diskfree="4GB" optional="yes" >
            <execute name="dumpit" run="7z:#Tools|dumpit" />
            <argument>/q /n /u</argument>
            <output name="Dump_dumpit_{SystemType}_{FullComputerName}.dmp" source="File" argument="/o {FileName}" />
            <output name="Dump_dumpit_{SystemType}_{FullComputerName}.log" source="StdOutErr" />
        </command>

        <!-- Assume most systems will have more than 2GB of Pagefile, thus preventing the collection when less than 4GB of disk space remains -->
        <command keyword="GetPagefile" diskfree="4GB" optional="yes">
            <execute name="Orc.exe" run="self:#GetThis" />
            <argument>%systemdrive% /config=res:#GetPagefile.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="Pagefile.7z" source="File" argument="/out={FileName}" />
            <output name="Pagefile.log" source="StdOutErr" />
            <output name="Pagefile.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>
    </archive>

    <archive name="ORC_{SystemType}_{FullComputerName}_FastFind.7z" keyword="ORC_FastFind" concurrency="1" repeat="Once" compression="fast" archive_timeout="120" optional="yes">
        <restrictions ElapsedTimeLimit="540" />

        <command keyword="capsule">
            <execute name="type" run="%windir%\System32\cmd.exe" />
            <argument>/c "rem"</argument>
            <output name="Capsule#{SystemType}#{FullComputerName}#{TimeStamp}#{RunId}.txt" source="StdOutErr" />
        </command>

        <command keyword="FastFind">
            <execute name="Orc.exe" run="self:#FastFind" />
            <argument>/config=res:#FastFind_config.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="FastFind_result.xml" source="File" argument="/out={FileName}" />
            <output name="FastFind.log" source="StdOutErr" />
            <output name="FastFind.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>
    </archive>

    <archive name="ORC_{SystemType}_{FullComputerName}_General.7z" keyword="ORC_General" concurrency="2" repeat="Once" compression="normal" archive_timeout="240">
        <restrictions ElapsedTimeLimit="2880" />

        <command keyword="capsule">
            <execute name="type" run="%windir%\System32\cmd.exe" />
            <argument>/c "rem"</argument>
            <output name="Capsule#{SystemType}#{FullComputerName}#{TimeStamp}#{RunId}.txt" source="StdOutErr" />
        </command>

        <!-- Commands order should try to priorize volatile artefacts collection first -->

        <command keyword="VSS_list">
            <execute name="Orc.exe" run="self:#NTFSUtil" />
            <argument>/VSS /log:console,level=critical,backtrace=critical</argument>
            <output name="VSS_list.csv" source="File" argument="/out={FileName}" />
            <output name="VSS_list.log" source="StdOutErr" />
            <output name="VSS_list.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="EnumLocs">
            <execute name="Orc.exe" run="self:#NTFSUtil" />
            <argument>/enumlocs /log:console,level=critical,backtrace=critical</argument>
            <output name="Enumlocs.txt" source="StdOutErr" />
            <output name="NTFSUtil.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="USNInfo" queue="flush">
            <execute name="Orc.exe" run="self:#USNInfo" />
            <argument>* /shadows=oldest,mid,newest /log:console,level=critical,backtrace=critical</argument>
            <output name="USNInfo.7z" source="File" argument="/out={FileName}" />
            <output name="USNInfo.log" source="StdOutErr" />
            <output name="USNInfo.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <!-- This key is mutually exclusive with USNInfo since the output files are the same. This is intended since this key is only to be used on filers with huge volumes -->
        <command keyword="USNInfo_system_noshadow" queue="flush" optional="yes">
            <execute name="Orc.exe" run="self:#USNInfo" />
            <argument>%systemdrive% /shadows={00000000-0000-0000-0000-000000000000} /log:console,level=critical,backtrace=critical</argument>
            <output name="USNInfo.7z" source="File" argument="/out={FileName}" />
            <output name="USNInfo.log" source="StdOutErr" />
            <output name="USNInfo.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="NTFSInfo_Quick_Shadows" queue="flush" >
            <execute name="Orc.exe" run="self:#NTFSInfo" />
            <argument>* /exclude=* /shadows=oldest,mid,newest /config=res:#NTFSInfo_Quick.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="NTFSInfo_quick.7z"  source="File" argument="/out={FileName}" />
            <output name="NTFSInfo_i30Info_quick.7z" source="File" argument="/i30info={FileName}"/>
            <output name="NTFSInfo_SecDesc_quick.7z" source="File" argument="/SecDescr={FileName}"/>
            <output name="NTFSInfo_quick.log" source="StdOutErr" />
            <output name="NTFSInfo_quick.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="NTFSInfo_Details_Current" queue="flush" >
            <execute name="Orc.exe" run="self:#NTFSInfo" />
            <argument>* /shadows={00000000-0000-0000-0000-000000000000} /config=res:#NTFSInfo_Details.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="NTFSInfo_details.7z"  source="File" argument="/out={FileName}" />
            <output name="NTFSInfo_i30Info_details.7z" source="File" argument="/i30info={FileName}"/>
            <output name="NTFSInfo_SecDesc_details.7z" source="File" argument="/SecDescr={FileName}"/>
            <output name="NTFSInfo_details.log" source="StdOutErr" />
            <output name="NTFSInfo_details.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <!-- This key is mutually exclusive with NTFSInfo_Details_Current since the output files are the same. This is intended since this key is only to be used on filers with huge volumes -->
        <command keyword="NTFSInfo_Details_system_noshadow" queue="flush" optional="yes">
            <execute name="Orc.exe" run="self:#NTFSInfo" />
            <argument>%systemdrive% /shadows={00000000-0000-0000-0000-000000000000} /config=res:#NTFSInfo_Details.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="NTFSInfo_details.7z"  source="File" argument="/out={FileName}" />
            <output name="NTFSInfo_i30Info_details.7z" source="File" argument="/i30info={FileName}"/>
            <output name="NTFSInfo_SecDesc_details.7z" source="File" argument="/SecDescr={FileName}"/>
            <output name="NTFSInfo_details.log" source="StdOutErr" />
            <output name="NTFSInfo_details.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="NTFSInfoNoLimit" queue="flush" optional="yes">
            <execute name="Orc.exe" run="self:#NTFSInfo" />
            <argument>* /config=res:#NTFSInfo_nolimit.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="NTFSInfo_nolimit.7z"  source="File" argument="/out={FileName}" />
            <output name="NTFSInfo_i30Info_nolimit.7z" source="File" argument="/i30info={FileName}"/>
            <output name="NTFSInfo_SecDesc_nolimit.7z" source="File" argument="/SecDescr={FileName}"/>
            <output name="NTFSInfo_nolimit.log" source="StdOutErr" />
            <output name="NTFSInfo_nolimit.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="FatInfo" >
