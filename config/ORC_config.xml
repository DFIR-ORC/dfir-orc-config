            <output name="GetBrowsers_History.7z" source="File" argument="/out={FileName}" />
            <output name="GetBrowsers_History.log" source="StdOutErr" />
            <output name="GetBrowsers_History.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="GetBrowsers_Artefacts" optional="yes">
