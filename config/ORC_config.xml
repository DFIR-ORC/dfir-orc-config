            <output name="GetThis_Protected.7z" source="File" argument="/out={FileName}" />
            <output name="GetThis_Protected.log" source="StdOutErr" />
            <output name="GetThis_Protected.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="GetThis_Optional" optional="yes">
            <execute name="Orc.exe" run="self:#GetThis" />
            <argument>* /shadows=oldest,mid,newest /config=res:#GetThis_Optional.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="GetThis_Optional.7z" source="File" argument="/out={FileName}" />
            <output name="GetThis_Optional.log" source="StdOutErr" />
            <output name="GetThis_Optional.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <command keyword="GetBrowsers_History">
