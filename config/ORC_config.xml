            <argument>/log:console,level=critical,backtrace=critical</argument>
            <output name="GetObjInfo.csv" source="File" argument="/out={FileName}" />
            <output name="GetObjInfo.log" source="StdOutErr" />
            <output name="GetObjInfo.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
