            <argument>* /shadows=oldest,mid,newest /config=res:#GetBrowsers_History.xml /log:console,level=critical,backtrace=critical</argument>
            <output name="GetBrowsers_History.7z" source="File" argument="/out={FileName}" />
            <output name="GetBrowsers_History.log" source="StdOutErr" />
            <output name="GetBrowsers_History.dev.log" source="File" argument="/log:file,output={FileName},level=info,backtrace=error" />
        </command>

        <!-- This key is mutually exclusive with GetBrowsers_History since the output files are the same. This is intended since this key is only to be used on filers with huge volumes -->
        <command keyword="GetBrowsers_History_system_noshadow" optional="yes">
