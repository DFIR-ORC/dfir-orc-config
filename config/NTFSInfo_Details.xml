<?xml version="1.0"?>

<ntfsinfo walker="MFT" resurrect="resident">
  <!-- The location element is only informational in this file and should be overridden from the CLI (to add shadows parsing, more volumes, etc...) -->
  <location>%systemdrive%</location>
  <columns>
    <default>Default,FirstBytes,SecurityDirectorySize,SecurityDirectorySignatureSize</default>
    <omit SizeGT="10M">MD5,SHA1,SHA256,PeMD5,PeSHA1,PeSHA256</omit>
    <add HasPE="">MD5,SHA1,SHA256,PeMD5,PeSHA1,PeSHA256,Details,Authenticode</add>
  </columns>
</ntfsinfo>

